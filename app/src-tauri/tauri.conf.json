{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShibaNC",
  "version": "0.1.0",
  "identifier": "com.shibanc.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShibaNC — 3-Axis G-Code Toolpath & Solid Simulation",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "nsis/sidebar.bmp",
        "headerImage": "nsis/header.bmp",
        "template": "nsis/installer.nsi",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "fileAssociations": [
      {
        "ext": ["nc", "tap", "gcode", "cnc", "ngc", "anc", "iso", "plt", "mpf"],
        "name": "CNC Toolpath G-Code",
        "description": "CNC G-Code Toolpath File",
        "role": "Viewer",
        "mimeType": "application/x-gcode"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGNEEyQzUxOUVGMzA3RDEKUldUUkIvT2VVU3hLajA5M1p3Rmp3MkdKclF4b1Z6eUpxY1hsdk93R1l1b2J6b1dKclF4b1Z6eQo=",
      "endpoints": [
        "https://github.com/Wonvy/ShibaNC/releases/latest/download/latest.json"
      ]
    }
  }
}
