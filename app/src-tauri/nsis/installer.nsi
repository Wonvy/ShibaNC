Function PageShibaOptions
  ${If} $PassiveMode = 1
  ${OrIf} $UpdateMode = 1
    Abort
  ${EndIf}

  !insertmacro MUI_HEADER_TEXT "$(shibaOptHeaderTitle)" "$(shibaOptHeaderSub)"
  nsDialogs::Create 1018
  Pop $0
  ${IfThen} $0 == error ${|} Abort ${|}

  ${NSD_CreateLabel} 0 4u 100% 20u "$(shibaOptIntro)"
  Pop $1

  ${NSD_CreateCheckBox} 10u 30u -10u 14u "$(shibaOptAssocTitle)"
  Pop $ChkAssocCtrl
  ${If} $OptEnableAssoc = 1
    ${NSD_Check} $ChkAssocCtrl
  ${EndIf}

  ${NSD_CreateLabel} 24u 45u -14u 14u "$(shibaOptAssocDesc)"
  Pop $2

  ${NSD_CreateCheckBox} 10u 66u -10u 14u "$(shibaOptThumbTitle)"
  Pop $ChkThumbCtrl
  ${If} $OptEnableThumb = 1
    ${NSD_Check} $ChkThumbCtrl
  ${EndIf}

  ${NSD_CreateLabel} 24u 81u -14u 14u "$(shibaOptThumbDesc)"
  Pop $3

  ${NSD_CreateCheckBox} 10u 104u -10u 14u "$(createDesktop)"
  Pop $ChkDesktopCtrl
  ${If} $OptEnableDesktop = 1
    ${NSD_Check} $ChkDesktopCtrl
  ${EndIf}

  nsDialogs::Show
FunctionEnd

Function PageLeaveShibaOptions
  ${NSD_GetState} $ChkAssocCtrl $0
  ${If} $0 == ${BST_CHECKED}
    StrCpy $OptEnableAssoc 1
  ${Else}
    StrCpy $OptEnableAssoc 0
  ${EndIf}

  ${NSD_GetState} $ChkThumbCtrl $0
  ${If} $0 == ${BST_CHECKED}
    StrCpy $OptEnableThumb 1
  ${Else}
    StrCpy $OptEnableThumb 0
  ${EndIf}

  ${NSD_GetState} $ChkDesktopCtrl $0
  ${If} $0 == ${BST_CHECKED}
    StrCpy $OptEnableDesktop 1
  ${Else}
    StrCpy $OptEnableDesktop 0
  ${EndIf}
FunctionEnd

